# --- Uygulama ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# --- Veritabani (Supabase) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# DATABASE_URL: "Transaction pooler" (port 6543) - uygulamanin normal calisirken
#   kullandigi baglanti. Sonuna ?pgbouncer=true eklenmelidir.
# DIRECT_URL:   "Direct connection" veya "Session pooler" (port 5432) - sadece
#   `prisma migrate` calistirirken kullanilir.
#
# Ornek (kendi sifrenizi ve proje referansinizi Supabase'ten alin):
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SIFRENIZ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:SIFRENIZ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- JWT ---
JWT_ACCESS_SECRET="degistir-bu-cok-gizli-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="degistir-bu-cok-gizli-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Guvenlik ---
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Push Bildirimleri (VAPID) ---
# Bu degerler onceden uretildi, degistirmeyin (frontend'deki public key ile eslesmesi gerekir).
# Farkli bir cift kullanmak isterseniz: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BFMxXjliuJExS0kzKkqZwfUN74Ber7Fmrksdlcdz4v8Dh_XdgsCtsQ8LKt3wgTnhEN2zfmwdxeWaq__7mLF6DVw"
VAPID_PRIVATE_KEY="rsfOXYtzrN6XlYn7cXoGHG43dlfit7YjPbz0AjLT2co"
VAPID_SUBJECT="mailto:destek@belhandar.com"
