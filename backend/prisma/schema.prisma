// ============================================================================
// Belhandar Partner - Veritabani Semasi
// Para birimleri KURUS (integer) olarak saklanir. Ornek: 125050 => 1.250,50 TL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  PARTNER
  PRODUCTION
  WAREHOUSE
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CommissionType {
  PERCENTAGE // yuzde bazli
  FIXED      // sabit TL (kurus) bazli
}

enum StockMovementType {
  ORDER_RECEIVED // siparis ile stok girisi
  SALE           // satis ile stok cikisi
  RETURN_OUT     // musteriden paydasa iade (paydas stogundan dusme - musteri urunu geri getirdi ama henuz merkeze donmedi senaryosu icin ayrilabilir)
  RETURN_IN      // iade kabul edildi, stok geri eklendi
  ADJUSTMENT     // admin/manuel duzeltme
  CANCELLED_REVERT // iptal edilen satis/siparisin geri alinmasi
}

enum SaleChannel {
  KARGO
  ELDEN
}

enum SaleStatus {
  COMPLETED
  VOID // iptal - fiziksel silinmez
}

enum OrderStatus {
  PENDING_APPROVAL   // Onay Bekliyor
  APPROVED           // Onaylandi
  REJECTED           // Reddedildi
  IN_PRODUCTION_QUEUE// Uretim Bekliyor
  IN_PRODUCTION       // Uretimde
  QUALITY_CHECK       // Kalite Kontrol
  READY               // Hazir
  SHIPPED             // Kargoya Verildi
  DELIVERED           // Teslim Edildi
  CANCELLED           // Iptal
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  ORDER_APPROVED
  ORDER_IN_PRODUCTION
  ORDER_SHIPPED
  ORDER_DELIVERED
  LOW_STOCK
  PAYMENT_MADE
  NEW_PARTNER_REGISTERED
  NEW_ORDER_RECEIVED
  STOCK_CRITICAL
  GENERIC
}

// ----------------------------------------------------------------------------
// USER & AUTH
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  username     String     @unique
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(PARTNER)
  status       UserStatus @default(PENDING_APPROVAL)
  avatarUrl    String?

  approvedById String?
  approvedBy   User?      @relation("ApprovedUsers", fields: [approvedById], references: [id])
  approvedUsers User[]    @relation("ApprovedUsers")
  approvedAt   DateTime?
  rejectionReason String?

  kvkkAcceptedAt DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  partnerProfile   PartnerProfile?
  refreshTokens    RefreshToken[]
  stockMovements   StockMovement[]      @relation("StockMovementActor")
  orderStatusLogs  OrderStatusHistory[] @relation("OrderStatusActor")
  auditLogs        AuditLog[]           @relation("AuditActor")
  notifications    Notification[]
  paymentsMadeBy   Payment[]            @relation("PaymentActor")
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenHash String?
  createdByIp String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// PARTNER PROFILE
// ----------------------------------------------------------------------------

model PartnerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  city      String
  district  String
  address   String
  iban      String
  taxId     String?
  taxOffice String?

  commissionPlanId String?
  commissionPlan   CommissionPlan? @relation(fields: [commissionPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks    PartnerStock[]
  sales     Sale[]
  orders    Order[]
  earnings  Earning[]
  payments  Payment[]

  @@map("partner_profiles")
}

// Esnek kar/komisyon plani - paydas bazinda farkli oranlar tanimlanabilir (madde 7)
model CommissionPlan {
  id        String         @id @default(uuid())
  name      String         @unique // orn: "Standart %20", "VIP %35"
  type      CommissionType
  // PERCENTAGE ise: 2000 = %20.00 (yuzde * 100, iki hane hassasiyet)
  // FIXED ise: kurus cinsinden sabit kazanc tutari
  value     Int
  isDefault Boolean        @default(false)
  isActive  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners  PartnerProfile[]

  @@map("commission_plans")
}

// ----------------------------------------------------------------------------
// PRODUCT
// ----------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  name        String
  productCode String   @unique
  perfumeType String?  // Eau de Parfum, Eau de Toilette vb.
  description String?
  isActive    Boolean  @default(true)
  images      ProductImage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ProductVariant[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

// Hacim/ml bazli varyant - fiyatlandirma ve stok varyant bazinda tutulur
model ProductVariant {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  volumeMl         Int
  barcode          String? @unique
  sku              String  @unique

  // Tum para alanlari KURUS cinsinden
  retailPriceCents      Int // normal satis fiyati
  partnerPriceCents     Int // paydas alis fiyati
  // partnerProfitCents alan olarak SAKLANMAZ; retail-partner farkindan turetilir
  // (veri butunlugu: tek kaynaktan hesaplama)

  centralStock     Int     @default(0) // Belhandar merkez stogu (uretim/depo)
  minStockLevel    Int     @default(10)

  isActive         Boolean @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partnerStocks    PartnerStock[]
  stockMovements   StockMovement[]
  saleItems        SaleItem[]
  orderItems       OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ----------------------------------------------------------------------------
// PARTNER STOCK
// ----------------------------------------------------------------------------

model PartnerStock {
  id               String         @id @default(uuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])

  quantity         Int            @default(0)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([partnerProfileId, variantId])
  @@map("partner_stocks")
}

model StockMovement {
  id               String             @id @default(uuid())
  partnerProfileId String?            // null ise merkez/depo hareketi
  variantId        String
  variant          ProductVariant     @relation(fields: [variantId], references: [id])

  type             StockMovementType
  quantityChange   Int                // + giris, - cikis
  reason           String?
  relatedSaleId    String?
  relatedOrderId   String?

  actorUserId      String
  actor            User               @relation("StockMovementActor", fields: [actorUserId], references: [id])

  createdAt        DateTime           @default(now())

  @@index([partnerProfileId])
  @@index([variantId])
  @@map("stock_movements")
}

// ----------------------------------------------------------------------------
// SALES
// ----------------------------------------------------------------------------

model ShippingRate {
  id             String   @id @default(uuid())
  minAmountCents Int      // bu tutar ve uzerinde gecerli (kurus)
  maxAmountCents Int?     // null = ust sinir yok (bu ve uzeri icin)
  feeCents       Int      // kargo ucreti (kurus)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shipping_rates")
}

model Sale {
  id               String         @id @default(uuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])

  channel          SaleChannel
  status           SaleStatus     @default(COMPLETED)

  customerName     String?
  customerPhone    String?
  note             String?

  saleDate         DateTime       @default(now())

  totalAmountCents  Int           // toplam satis tutari (kurus)
  totalProfitCents  Int           // paydasin toplam kazanci (kurus)
  shippingFeeCents  Int?          // KARGO satislarda uygulanan kargo ucreti (kurus); ELDEN'de null
  shippingPaidByAdmin Boolean     @default(false) // true ise kargo ucretini Belhandar karsilar, musteriden istenmez (varsayilan: karsi odemeli - musteri oder)

  voidedAt         DateTime?
  voidReason       String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            SaleItem[]
  earning          Earning?

  @@index([partnerProfileId])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id            String         @id @default(uuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  quantity      Int
  unitPriceCents  Int // o anki satis fiyati (snapshot)
  unitProfitCents Int // o anki birim kazanc (snapshot)

  @@map("sale_items")
}

// ----------------------------------------------------------------------------
// EARNINGS
// ----------------------------------------------------------------------------

model Earning {
  id               String         @id @default(uuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])

  saleId           String?        @unique
  sale             Sale?          @relation(fields: [saleId], references: [id])

  amountCents      Int            // pozitif kazanc, VOID durumunda ters kayit ayni tabloya negatif olarak girilir
  description      String?

  createdAt        DateTime       @default(now())

  @@index([partnerProfileId])
  @@map("earnings")
}

// ----------------------------------------------------------------------------
// ORDERS (paydasin Belhandar'dan urun siparisi)
// ----------------------------------------------------------------------------

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique // orn: BH-2026-00125
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])

  status           OrderStatus    @default(PENDING_APPROVAL)
  totalAmountCents Int

  shippingCarrier  String?
  trackingNumber   String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]

  @@index([partnerProfileId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  quantity       Int
  unitPriceCents Int // siparis anindaki paydas fiyati (snapshot)
  testerQuantity Int            @default(0) // paydasin talep ettigi bedava numune/tester adedi (ucretsiz, siparis tutarina eklenmez)

  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(uuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus   OrderStatus?
  toStatus     OrderStatus

  actorUserId  String
  actor        User        @relation("OrderStatusActor", fields: [actorUserId], references: [id])

  note         String?
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ----------------------------------------------------------------------------
// PAYMENTS (paydas odeme/cuzdan takibi)
// ----------------------------------------------------------------------------

model Payment {
  id               String         @id @default(uuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])

  amountCents      Int
  status           PaymentStatus  @default(PENDING)
  iban             String
  description      String?

  // Paydas odeme talep ettiginde bu alanlar bos kalir; admin onayladiginda doldurulur.
  paidById         String?
  paidBy           User?          @relation("PaymentActor", fields: [paidById], references: [id])
  paidAt           DateTime?

  requestedByPartner Boolean      @default(false)
  rejectionReason    String?

  createdAt        DateTime       @default(now())

  @@index([partnerProfileId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean           @default(false)
  metadata  Json?

  createdAt DateTime          @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// AUDIT LOG
// ----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  action       String   // orn: "PARTNER_COMMISSION_CHANGED", "ORDER_APPROVED"
  entityType   String   // orn: "User", "Order", "Product"
  entityId     String?

  beforeData   Json?
  afterData    Json?

  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// SETTINGS (tekil satir)
// ----------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Settings {
  id                     String   @id @default("global")
  brandName              String   @default("Belhandar")
  logoUrl                String?
  currency               String   @default("TRY")
  defaultCommissionType  CommissionType @default(PERCENTAGE)
  defaultCommissionValue Int      @default(2000) // %20.00
  defaultMinStockLevel   Int      @default(10)
  updatedAt              DateTime @updatedAt

  @@map("settings")
}
